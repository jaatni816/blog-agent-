# Copy this file to ".env" and fill in every value.
# Never commit the real .env file.

# --- Groq (topic + article writing) -----------------------------------------
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Extra output room for reasoning models (default 8192)
GROQ_MAX_TOKENS=8192

# --- Pixabay (free images) ---------------------------------------------------
# Free key: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# --- Google OAuth 2.0 / Blogger ----------------------------------------------
# Get all three by running:  python scripts/get_refresh_token.py
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Blogger blog id, looks like: 1234567890123456789
# Get it from: https://www.googleapis.com/blogger/v3/users/self/blogs
BLOG_ID=

# --- Content ------------------------------------------------------------------
BLOG_NICHE=Technology and AI tools for beginners
BLOG_LANGUAGE=English

# true = save as a draft (safe for testing), false = publish live
PUBLISH_AS_DRAFT=true